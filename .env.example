# Copy to .env and adjust. Every setting is optional; see README for the full list.
MAX_UPLOAD_MB=20
MAX_PAGES=100
DOCLING_DEVICE=auto
DOCLING_THREADS=4
# DOCLING_ARTIFACTS_PATH=models/docling
LOG_LEVEL=INFO
LOG_JSON=true
# Models, providers, the knowledge index and the workspace live in this YAML file.
# ASSISTANT_CONFIG=config/model_config.yml
# LIBRARY_RATE_CALLS=30
# SEARCH_RATE_CALLS=120
# ASSISTANT_RATE_CALLS=30
# Business workspace: Fernet key encrypting connector tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset: a key is generated on first need and kept in data/secrets.key.
# BUSINESS_SECRETS_KEY=
